# =============================================================================
# Price Pulse — environment variables
# Copy this file to .env and fill in your values.
# All variables are loaded by Docker Compose from the repo root.
# =============================================================================

# ---------------------------------------------------------------------------
# Backend — Database
# ---------------------------------------------------------------------------
# Async Postgres connection URL (used by SQLAlchemy + Alembic)
DATABASE_URL=postgresql+asyncpg://price_pulse:price_pulse@postgres:5432/price_pulse

# Synchronous URL — used only by Alembic migration runner (not the app)
DATABASE_SYNC_URL=postgresql://price_pulse:price_pulse@postgres:5432/price_pulse

# Postgres superuser credentials (used by the postgres service container)
POSTGRES_USER=price_pulse
POSTGRES_PASSWORD=price_pulse
POSTGRES_DB=price_pulse

# ---------------------------------------------------------------------------
# Backend — Redis / Celery
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---------------------------------------------------------------------------
# Backend — Application
# ---------------------------------------------------------------------------
# Must be changed in production; generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# Set to "true" to enable FastAPI debug mode (never in production)
DEBUG=false

# Required in production (DEBUG=false). JSON list of allowed origins.
# pydantic-settings v2 JSON-decodes complex fields from env vars, so use JSON array syntax.
# Example for production: CORS_ORIGINS=["https://app.example.com"]
CORS_ORIGINS=["http://localhost"]

# Interval between scheduled scrapes for each product (minutes)
SCRAPE_INTERVAL_MINUTES=30

# Alert cooldown — minimum hours between repeat notifications for the same alert
ALERT_COOLDOWN_HOURS=24

# Minimum delay (seconds) between requests to the same domain (rate limiting)
SCRAPE_MIN_DELAY_SECONDS=2

# Retention (days) for scrape-job lifecycle rows (Item 17). The daily
# prune_scrape_jobs beat task deletes ScrapeJob rows older than this; without a
# prune the table grows unbounded at the scheduled scrape cadence.
SCRAPE_JOB_RETENTION_DAYS=7

# ---------------------------------------------------------------------------
# Anti-blocking (Item 15) — rotating proxies for bot-protected retailers
# ---------------------------------------------------------------------------
# Bring-your-own proxy list, comma-separated. Empty ⇒ proxying disabled
# (direct egress). A rotating/residential list is expected in production.
# Format per entry: scheme://[user:pass@]host[:port]
#   schemes: http, https, socks5, socks5h, socks4
# Example: PROXY_URLS=http://user:pass@proxy1.example.com:8080,http://user:pass@proxy2.example.com:8080
PROXY_URLS=

# Max proxy rotations per fetch on a detected block/CAPTCHA before the scrape
# resolves to a 'blocked'/'captcha' record. A dead proxy rotates without
# consuming this budget.
MAX_PROXY_ROTATIONS=2

# ---------------------------------------------------------------------------
# Self-healing selectors (Item 16) — LLM-generated CSS selectors
# ---------------------------------------------------------------------------
# When deterministic extraction finds no price on a page that loaded fine
# (a 'selector_miss'), an LLM generates a replacement CSS selector, which is
# validated and cached per host and reused with no further LLM calls.
#
# Two credential scopes exist (the repo has no auth/user system yet):
#   1. the admin default below — the deployer's key, used for every host;
#   2. a per-product bring-your-own key, set via
#      PUT /api/v1/products/{id}/llm-credential, encrypted at rest and used in
#      preference to the admin default.
# Resolution order at generation time: product BYO → admin default → disabled.
#
# NEVER commit a real key. An empty LLM_API_KEY disables the admin default; with
# no product BYO key either, generation is a no-op — scrapes still complete and
# record 'selector_miss'.
#
# Provider → required variables:
#   openai      LLM_MODEL, LLM_API_KEY
#   anthropic   LLM_MODEL, LLM_API_KEY
#   openrouter  LLM_MODEL, LLM_API_KEY
#   azure       LLM_MODEL (= your deployment name), LLM_API_KEY,
#               AZURE_OPENAI_ENDPOINT (+ AZURE_OPENAI_API_VERSION, see below)
# For openrouter, LLM_MODEL must be "<provider>/<model>", e.g.
# anthropic/claude-sonnet-4.6.
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.2
LLM_API_KEY=

# Azure OpenAI only — required when LLM_PROVIDER=azure and a key is set.
# The two Azure endpoint styles take OPPOSITE configuration:
#   classic  https://<resource>.openai.azure.com        → API version REQUIRED
#   v1       https://<resource>.openai.azure.com/openai/v1  → API version must be EMPTY
# Getting this wrong is rejected at startup, not mid-scrape.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=

# Max bytes of trimmed page HTML sent to the LLM in one generation call.
SELECTOR_HTML_MAX_BYTES=120000

# Consecutive failed generate-and-validate attempts before a host's selector
# profile is parked as 'failed' (bounds spend on an unhealable page).
SELECTOR_MAX_REGEN_ATTEMPTS=3

# Minimum hours between regeneration attempts for the same host.
SELECTOR_REGEN_COOLDOWN_HOURS=6

# Structlog log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Mounts gated test-only control endpoints under /api/v1/_test/ when "true".
# MUST stay false everywhere except the e2e stack — docker-compose.e2e.yml sets
# it to true so the hooks never exist in production.
E2E_TEST_HOOKS=false

# ---------------------------------------------------------------------------
# Frontend (Vite build-time variables — must be prefixed with VITE_)
# ---------------------------------------------------------------------------
# Base URL that the React SPA uses to reach the backend API
VITE_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# pgAdmin (dev only — docker-compose.dev.yml)
# ---------------------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@pricepulse.local
PGADMIN_DEFAULT_PASSWORD=admin
